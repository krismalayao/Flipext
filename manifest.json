{
    "manifest_version": 3,
    "name": "Flipext: Text Converter",
    "version": "1.0",
    "description": "A Text Converter extension.",
    "permissions": [
        "sidePanel",
        "clipboardRead",
        "clipboardWrite"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "A side panel will open."
    },
    "side_panel": {
        "default_path": "flipext.html"
    }
}