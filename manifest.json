{
    "manifest_version": 3,
    "name": "Flipext: Text Converter",
    "version": "1.0",
    "description": "Transform text instantly right from your browser's side panel. Easy to understand and works 100% offline.",
    "permissions": [
        "sidePanel",
        "clipboardRead",
        "clipboardWrite"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open Flipext Side Panel",
        "default_icon": {
            "16": "resources/short_logo.png",
            "48": "resources/short_logo.png",
            "128": "resources/short_logo.png"
        }
    },
    "icons": {
        "16": "resources/short_logo.png",
        "48": "resources/short_logo.png",
        "128": "resources/short_logo.png"
    },
    "side_panel": {
        "default_path": "flipext.html"
    }
}